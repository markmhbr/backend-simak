# --- APP CONFIGURATION ---
NODE_ENV=production
# PORT biasanya ditentukan otomatis oleh cPanel/CloudLinux di shared hosting
PORT=3000
# Ganti dengan domain atau subdomain Anda (contoh: https://api.domainanda.com)
APP_URL=http://localhost:3000

# --- DATABASE CONFIGURATION ---
# Sesuaikan USER, PASSWORD, dan DBNAME sesuai yang dibuat di MySQL/PostgreSQL cPanel
# Jika menggunakan MySQL (default shared hosting):
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME"
# Jika menggunakan PostgreSQL (jika tersedia di paket Anda):
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME?schema=public"

# --- REDIS CONFIGURATION ---
# Shared hosting Domainesia biasanya tidak menyediakan Redis secara default.
# Jika tidak ada, Anda mungkin perlu menggunakan provider eksternal atau mematikan fitur Redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- JWT CONFIGURATION ---
# Gunakan string acak yang panjang dan kuat
JWT_SECRET=GANTI_DENGAN_SECRET_YANG_KUAT_MINIMAL_32_KARAKTER
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=GANTI_DENGAN_REFRESH_SECRET_YANG_KUAT
JWT_REFRESH_EXPIRATION=7d

# --- MANDALA CONFIGURATION ---
URL_MANDALA=http://localhost:3000
KEY_MANDALA=GANTI_DENGAN_KEY_MANDALA_YANG_KUAT
