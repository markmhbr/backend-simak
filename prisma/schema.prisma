generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["dapodik", "simak", "mandala"]
}

model Sekolah {
  sekolah_id                    String                @id @default(uuid()) @db.Uuid
  nama                          String
  nss                           String?
  npsn                          String?               @unique
  bentuk_pendidikan_id          Int?
  bentuk_pendidikan_id_str      String?
  status_sekolah                String?
  status_sekolah_str            String?
  alamat_jalan                  String?
  rt                            String?
  rw                            String?
  kode_wilayah                  String?
  kode_pos                      String?
  nomor_telepon                 String?
  nomor_fax                     String?
  email                         String?
  website                       String?
  is_sks                        Boolean?              @default(false)
  lintang                       Decimal?
  bujur                         Decimal?
  dusun                         String?
  desa_kelurahan                String?
  kecamatan                     String?
  kabupaten_kota                String?
  provinsi                      String?
  cadisdik_edit_count           Int                   @default(0)
  spmb                          String?
  logo                          String?
  background_kartu_gtk          String?
  background_kartu_pesertadidik String?
  peta                          String?
  social_media                  Json?
  created_at                    DateTime              @default(now())
  updated_at                    DateTime              @updatedAt
  cadisdik_id                   String?               @db.Uuid
  cadisdik                      Cadisdik?             @relation(fields: [cadisdik_id], references: [cadisdik_id])
  jadwal_pelajaran              JadwalPelajaran[]
  jenis_jadwal                  JenisJadwal[]
  hari_libur                    HariLibur[]
  presensi_pd                    PresensiPesertaDidik[]
  presensi_gtk                   PresensiGtk[]
  izin                          Izin[]
  presensi_mapel                 PresensiMapel[]
  pengaturan_tagihan    PengaturanTagihan[]
  spp                   Spp[]
  riwayat_transaksi_spp RiwayatTransaksiSpp[]
  pengaturan_nomor_surat PengaturanNomorSurat[]
  template_surat         TemplateSurat[]
  surat_masuk            SuratMasuk[]
  surat_keluar           SuratKeluar[]
  mapping_pengawas       MappingPengawas[]

  @@map("sekolah")
  @@schema("dapodik")
}

model RombonganBelajar {
  rombongan_belajar_id      String            @id @default(uuid()) @db.Uuid
  nama                      String
  tingkat_pendidikan_id     String?
  tingkat_pendidikan_id_str String?
  semester_id               String?
  jenis_rombel              String?
  jenis_rombel_str          String?
  kurikulum_id              Int?
  kurikulum_id_str          String?
  id_ruang                  String?           @db.Uuid
  id_ruang_str              String?
  moving_class              String?
  ptk_id                    String?           @db.Uuid
  ptk_id_str                String?
  jurusan_id                String?
  jurusan_id_str            String?
  created_at                DateTime          @default(now())
  updated_at                DateTime          @updatedAt
  sekolah_id                String?           @db.Uuid
  id_ekskul                 String?
  id_kelas_ekskul           String?
  nm_ekskul                 String?
  sk_ekskul                 String?
  anggota_rombel            AnggotaRombel[]
  pembelajaran              Pembelajaran[]
  jadwal_pelajaran          JadwalPelajaran[]
  peserta_didik         PesertaDidik[]            @relation("RombelPesertaDidik")
  pengaturan_rombel     PengaturanTagihanRombel[]

  @@index([sekolah_id])
  @@map("rombongan_belajar")
  @@schema("dapodik")
}

model AnggotaRombel {
  anggota_rombel_id        String           @id @default(uuid()) @db.Uuid
  rombongan_belajar_id     String           @db.Uuid
  peserta_didik_id         String           @db.Uuid
  jenis_pendaftaran_id     String?
  jenis_pendaftaran_id_str String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt
  sekolah_id               String?          @db.Uuid
  rombongan_belajar        RombonganBelajar @relation(fields: [rombongan_belajar_id], references: [rombongan_belajar_id], onDelete: Cascade)

  @@index([rombongan_belajar_id])
  @@index([sekolah_id])
  @@map("anggota_rombel")
  @@schema("dapodik")
}

model Pembelajaran {
  pembelajaran_id         String            @id @default(uuid()) @db.Uuid
  rombongan_belajar_id    String            @db.Uuid
  mata_pelajaran_id       String?
  mata_pelajaran_id_str   String?
  ptk_terdaftar_id        String?           @db.Uuid
  ptk_id                  String?           @db.Uuid
  nama_mata_pelajaran     String?
  induk_pembelajaran_id   String?           @db.Uuid
  jam_mengajar_per_minggu String?
  status_di_kurikulum     String?
  status_di_kurikulum_str String?
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt
  sekolah_id              String?           @db.Uuid
  ptk_id_str              String?
  gtk                     Gtk?              @relation(fields: [ptk_id], references: [ptk_id])
  rombongan_belajar       RombonganBelajar  @relation(fields: [rombongan_belajar_id], references: [rombongan_belajar_id], onDelete: Cascade)
  jadwal_pelajaran        JadwalPelajaran[]

  @@index([rombongan_belajar_id])
  @@index([sekolah_id])
  @@map("pembelajaran")
  @@schema("dapodik")
}

