generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["dapodik", "mandala", "ref", "simak"]
}

model Sekolah {
  // Kolom dari data JSON Baru
  sekolah_id                  String    @id @default(uuid()) @db.Uuid
  nama                        String
  nama_nomenklatur            String?
  nss                         String?
  npsn                        String?   @unique
  bentuk_pendidikan_id        Int?
  alamat_jalan                String?
  rt                          String?
  rw                          String?
  nama_dusun                  String?
  desa_kelurahan              String?
  kode_wilayah                String?
  kode_pos                    String?
  lintang                     Decimal?
  bujur                       Decimal?
  nomor_telepon               String?
  nomor_fax                   String?
  email                       String?
  website                     String?
  kebutuhan_khusus_id         Int?
  status_sekolah              String?
  sk_pendirian_sekolah        String?
  tanggal_sk_pendirian        String? // atau DateTime? tergantung kebutuhan parsing Anda
  status_kepemilikan_id       String?
  yayasan_id                  String?   @db.Uuid
  sk_izin_operasional         String?
  tanggal_sk_izin_operasional String? // atau DateTime?
  no_rekening                 String?
  nama_bank                   String?
  cabang_kcp_unit             String?
  rekening_atas_nama          String?
  mbs                         String?
  luas_tanah_milik            String? // atau Decimal? / Float?
  luas_tanah_bukan_milik      String? // atau Decimal? / Float?
  kode_registrasi             String?
  npwp                        String?
  nm_wp                       String?
  keaktifan                   String?
  flag                        String?
  create_date                 DateTime  @default(now())
  last_update                 DateTime  @updatedAt
  soft_delete                 String?
  last_sync                   DateTime?
  updater_id                  String?   @db.Uuid

  // Kolom lama yang diinstruksikan untuk DIPERTAHANKAN
  logo         String?
  cadisdik_id  String? @db.Uuid
  social_media Json?
  radius       Int?    @default(100)

  // Relasi dan Metadata Schema
  cadisdik               Cadisdik?              @relation(fields: [cadisdik_id], references: [cadisdik_id])
  mapping_pengawas       MappingPengawas[]
  hari_libur             HariLibur[]
  izin                   Izin[]
  jadwal_pelajaran       JadwalPelajaran[]
  jenis_jadwal           JenisJadwal[]
  pengaturan_nomor_surat PengaturanNomorSurat[]
  pengaturan_tagihan     PengaturanTagihan[]
  presensi_gtk           PresensiGtk[]
  presensi_mapel         PresensiMapel[]
  presensi_pd            PresensiPesertaDidik[]
  riwayat_transaksi_spp  RiwayatTransaksiSpp[]
  spp                    Spp[]
  surat_keluar           SuratKeluar[]
  surat_masuk            SuratMasuk[]
  template_surat         TemplateSurat[]

  @@map("sekolah")
  @@schema("dapodik")
}

model RombonganBelajar {
  rombongan_belajar_id  String    @id @default(uuid()) @db.Uuid
  sekolah_id            String?   @db.Uuid
  semester_id           String?
  id_ruang              String?   @db.Uuid
  tingkat_pendidikan_id Decimal?  @db.Decimal
  jurusan_sp_id         String?   @db.Uuid
  kurikulum_id          Int?
  nama                  String
  ptk_id                String?   @db.Uuid
  moving_class          Decimal?  @db.Decimal
  jenis_rombel          Decimal?  @db.Decimal
  sks                   Decimal?  @db.Decimal
  tanggal_mulai         DateTime? @db.Date
  tanggal_selesai       DateTime? @db.Date
  kebutuhan_khusus_id   Int?
  create_date           DateTime  @default(now())
  last_update           DateTime  @updatedAt
  soft_delete           Decimal?  @db.Decimal
  last_sync             DateTime?
  updater_id            String?   @db.Uuid

  jurusan_sp        JurusanSp? @relation("JurusanSpRombel", fields: [jurusan_sp_id], references: [jurusan_sp_id], onDelete: NoAction, onUpdate: NoAction)
  anggota_rombel    AnggotaRombel[]
  pembelajaran      Pembelajaran[]
  peserta_didik     PesertaDidik[]            @relation("RombelPesertaDidik")
  jadwal_pelajaran  JadwalPelajaran[]
  pengaturan_rombel PengaturanTagihanRombel[]

  @@index([sekolah_id])
  @@map("rombongan_belajar")
  @@schema("dapodik")
}

model JurusanSp {
  jurusan_sp_id         String    @id @default(uuid()) @db.Uuid
  sekolah_id            String?   @db.Uuid
  kebutuhan_khusus_id   Int
  jurusan_id            String
  nama_jurusan_sp       String
  sk_izin               String?
  tanggal_sk_izin       DateTime? @db.Date
  create_date           DateTime  @default(now())
  last_update           DateTime  @updatedAt
  soft_delete           Decimal?  @db.Decimal
  last_sync             DateTime?
  updater_id            String?   @db.Uuid

  rombongan_belajar     RombonganBelajar[] @relation("JurusanSpRombel")

  @@index([sekolah_id])
  @@map("jurusan_sp")
  @@schema("dapodik")
}

model AnggotaRombel {
  anggota_rombel_id    String    @id @default(uuid()) @db.Uuid
  rombongan_belajar_id String    @db.Uuid
  peserta_didik_id     String    @db.Uuid
  jenis_pendaftaran_id Decimal?  @db.Decimal
  sekolah_id           String?   @db.Uuid
  create_date          DateTime  @default(now())
  last_update          DateTime  @updatedAt
  soft_delete          Decimal?  @db.Decimal
  last_sync            DateTime?
  updater_id           String?   @db.Uuid

  rombongan_belajar RombonganBelajar @relation(fields: [rombongan_belajar_id], references: [rombongan_belajar_id], onDelete: Cascade)
  peserta_didik     PesertaDidik     @relation(fields: [peserta_didik_id], references: [peserta_didik_id], onDelete: Cascade)

  @@index([rombongan_belajar_id])
  @@index([sekolah_id])
  @@map("anggota_rombel")
  @@schema("dapodik")
}

model Pembelajaran {
  pembelajaran_id         String    @id @default(uuid()) @db.Uuid
  rombongan_belajar_id    String    @db.Uuid
  semester_id             String?
  mata_pelajaran_id       Int?
  ptk_terdaftar_id        String?   @db.Uuid
  ptk_id                  String?   @db.Uuid
  sk_mengajar             String?
  tanggal_sk_mengajar     DateTime? @db.Date
  jam_mengajar_per_minggu Decimal?  @db.Decimal
  status_di_kurikulum     Decimal?  @db.Decimal
  nama_mata_pelajaran     String?
  induk_pembelajaran_id   String?   @db.Uuid
  sekolah_id              String?   @db.Uuid
  create_date             DateTime  @default(now())
  last_update             DateTime  @updatedAt
  soft_delete             Decimal?  @db.Decimal
  last_sync               DateTime?
  updater_id              String?   @db.Uuid

  gtk               Gtk?              @relation(fields: [ptk_id], references: [ptk_id])
  rombongan_belajar RombonganBelajar  @relation(fields: [rombongan_belajar_id], references: [rombongan_belajar_id], onDelete: Cascade)
  jadwal_pelajaran  JadwalPelajaran[]

  @@index([rombongan_belajar_id])
  @@index([sekolah_id])
  @@map("pembelajaran")
  @@schema("dapodik")
}

model TugasTambahan {
  ptk_tugas_tambahan_id String    @id @default(uuid()) @db.Uuid
  ptk_id                String    @db.Uuid
  sekolah_id            String?   @db.Uuid
  jabatan_ptk_id        Decimal?  @db.Decimal
  jumlah_jam            Decimal?  @db.Decimal
  nomor_sk              String?
  tmt_tambahan          DateTime? @db.Date
  tst_tambahan          DateTime? @db.Date
  soft_delete           Decimal?  @db.Decimal
  create_date           DateTime  @default(now())
  last_update           DateTime  @updatedAt
  last_sync             DateTime?
  updater_id            String?   @db.Uuid

  gtk                  Gtk       @relation(fields: [ptk_id], references: [ptk_id])

  @@index([ptk_id])
  @@index([sekolah_id])
  @@map("tugas_tambahan")
  @@schema("dapodik")
}


model PesertaDidik {
  // --- Kolom dari tabel peserta_didik ---
  peserta_didik_id         String    @id @default(uuid()) @db.Uuid
  nama                     String
  jenis_kelamin            String?
  nisn                     String?
  nik                      String?
  no_kk                    String?
  tempat_lahir             String?
  tanggal_lahir            DateTime? @db.Date
  agama_id                 Int?      @db.SmallInt
  kebutuhan_khusus_id      Int?
  alamat_jalan             String?
  rt                       Decimal?  @db.Decimal
  rw                       Decimal?  @db.Decimal
  nama_dusun               String?
  desa_kelurahan           String?
  kode_wilayah             String?
  kode_pos                 String?
  lintang                  Decimal?  @db.Decimal
  bujur                    Decimal?  @db.Decimal
  jenis_tinggal_id         Decimal?  @db.Decimal
  alat_transportasi_id     Decimal?  @db.Decimal
  nik_ayah                 String?
  nik_ibu                  String?
  anak_keberapa            Decimal?  @db.Decimal
  nik_wali                 String?
  nomor_telepon_rumah      String?
  nomor_telepon_seluler    String?
  email                    String?
  penerima_kps             Decimal?  @db.Decimal
  no_kps                   String?
  layak_pip                Decimal?  @db.Decimal
  penerima_kip             Decimal?  @db.Decimal
  no_kip                   String?
  nm_kip                   String?
  no_kks                   String?
  reg_akta_lahir           String?
  id_layak_pip             Decimal?  @db.Decimal
  id_bank                  String?
  rekening_bank            String?
  nama_kcp                 String?
  rekening_atas_nama       String?
  status_data              Int?
  nama_ayah                String?
  tahun_lahir_ayah         Decimal?  @db.Decimal
  jenjang_pendidikan_ayah  Decimal?  @db.Decimal
  pekerjaan_id_ayah        Int?
  penghasilan_id_ayah      Int?
  kebutuhan_khusus_id_ayah Int?
  nama_ibu_kandung         String?
  tahun_lahir_ibu          Decimal?  @db.Decimal
  jenjang_pendidikan_ibu   Decimal?  @db.Decimal
  penghasilan_id_ibu       Int?
  pekerjaan_id_ibu         Int?
  kebutuhan_khusus_id_ibu  Int?
  nama_wali                String?
  tahun_lahir_wali         Decimal?  @db.Decimal
  jenjang_pendidikan_wali  Decimal?  @db.Decimal
  pekerjaan_id_wali        Int?
  penghasilan_id_wali      Int?
  kewarganegaraan          String?
  pekerjaan_id             Int?
  soft_delete              Decimal?  @db.Decimal

  // --- Kolom dari tabel registrasi_peserta_didik ---
  registrasi_id         String?   @db.Uuid
  jurusan_sp_id         String?   @db.Uuid
  sekolah_id            String?   @db.Uuid
  jenis_pendaftaran_id  Decimal?  @db.Decimal
  nipd                  String?
  tanggal_masuk_sekolah DateTime? @db.Date
  jenis_keluar_id       String?
  tanggal_keluar        DateTime? @db.Date
  keterangan            String?
  no_skhun              String?
  no_peserta_ujian      String?
  no_seri_ijazah        String?
  a_pernah_paud         Decimal?  @db.Decimal
  a_pernah_tk           Decimal?  @db.Decimal
  sekolah_asal          String?
  id_hobby              Decimal?  @db.Decimal
  id_cita               Decimal?  @db.Decimal

  // --- Kolom dari tabel peserta_didik_longitudinal ---
  berat_badan              Decimal?  @db.Decimal(38, 0)
  tinggi_badan             Decimal?  @db.Decimal(38, 0)
  lingkar_kepala           Decimal?  @db.Decimal(38, 0)
  jarak_rumah_ke_sekolah   Decimal?  @db.Decimal(38, 0)
  jarak_rumah_ke_sekolah_km Decimal? @db.Decimal(38, 0)
  waktu_tempuh_ke_sekolah  Decimal?  @db.Decimal(38, 0)
  menit_tempuh_ke_sekolah  Decimal?  @db.Decimal(38, 0)
  jumlah_saudara_kandung   Decimal?  @db.Decimal(38, 0)

  // --- Kolom SIMAK ---
  qr_token         String?
  foto             String?
  status           String   @default("Aktif")
  telegram_chat_id String?
  telegram_token   String?
  no_whatsapp      String?
  email_aktif      String?
  is_wali          Boolean? @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // --- Relations ---
  rombongan_belajar_id  String?                @db.Uuid
  rombongan_belajar     RombonganBelajar?      @relation("RombelPesertaDidik", fields: [rombongan_belajar_id], references: [rombongan_belajar_id])
  penggunas             Pengguna[]
  izin                  Izin[]
  pelanggaran           Pelanggaran[]          @relation("PesertaDidikPelanggaran")
  presensi_mapel        PresensiMapel[]
  presensi_pd           PresensiPesertaDidik[]
  riwayat_transaksi_spp RiwayatTransaksiSpp[]
  spp                   Spp[]
  surat_keluar          SuratKeluar[]
  anggota_akt_pd        AnggotaAktPd[]
  anggota_rombel        AnggotaRombel[]
  agama                 agama?                 @relation(fields: [agama_id], references: [agama_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sekolah_id])
  @@index([rombongan_belajar_id])
  @@index([qr_token])
  @@map("peserta_didik")
  @@schema("dapodik")
}

model Gtk {
  // --- Kolom dari tabel ptk ---
  ptk_id                       String    @id @default(uuid()) @db.Uuid
  nama                         String
  nip                          String?
  jenis_kelamin                String?
  tempat_lahir                 String?
  tanggal_lahir                DateTime? @db.Date
  nik                          String?
  no_kk                        String?
  niy_nigk                     String?
  nuptk                        String?
  nrg                          String?
  nuks                         String?
  status_kepegawaian_id        Int?      @db.SmallInt
  pengawas_bidang_studi_id     Int?
  agama_id                     Int?      @db.SmallInt
  alamat_jalan                 String?
  rt                           Decimal?  @db.Decimal
  rw                           Decimal?  @db.Decimal
  nama_dusun                   String?
  desa_kelurahan               String?
  kode_wilayah                 String?
  kode_pos                     String?
  lintang                      Decimal?  @db.Decimal
  bujur                        Decimal?  @db.Decimal
  no_telepon_rumah             String?
  no_hp                        String?
  email                        String?
  status_keaktifan_id          Decimal?  @db.Decimal
  sk_cpns                      String?
  tgl_cpns                     DateTime? @db.Date
  sk_pengangkatan              String?
  tmt_pengangkatan             DateTime? @db.Date
  lembaga_pengangkat_id        Decimal?  @db.Decimal
  pangkat_golongan_id          Decimal?  @db.Decimal
  keahlian_laboratorium_id     Int?      @db.SmallInt
  sumber_gaji_id               Decimal?  @db.Decimal
  nama_ibu_kandung             String?
  status_perkawinan            Decimal?  @db.Decimal
  nama_suami_istri             String?
  nip_suami_istri              String?
  pekerjaan_suami_istri        Int?
  tmt_pns                      DateTime? @db.Date
  sudah_lisensi_kepala_sekolah Decimal?  @db.Decimal
  jumlah_sekolah_binaan        Int?      @db.SmallInt
  pernah_diklat_kepengawasan   Decimal?  @db.Decimal
  nm_wp                        String?
  status_data                  Int?
  karpeg                       String?
  karpas                       String?
  mampu_handle_kk              Int?
  keahlian_braille             Decimal?  @db.Decimal
  keahlian_bhs_isyarat         Decimal?  @db.Decimal
  kebutuhan_khusus_id          Int?
  npwp                         String?
  kewarganegaraan              String?
  id_bank                      String?
  rekening_bank                String?
  rekening_atas_nama           String?
  blob_id                      String?   @db.Uuid
  create_date                  DateTime  @default(now())
  last_update                  DateTime  @updatedAt
  soft_delete                  Decimal?  @db.Decimal
  last_sync                    DateTime?
  updater_id                   String?   @db.Uuid

  // --- Kolom dari tabel ptk_terdaftar ---
  ptk_terdaftar_id    String?   @db.Uuid
  sekolah_id          String?   @db.Uuid
  jenis_keluar_id     String?
  jabatan_ptk_id      Decimal?  @db.Decimal
  tahun_ajaran_id     Decimal?  @db.Decimal
  jenis_ptk_id        Decimal?  @db.Decimal
  nomor_surat_tugas   String?
  tanggal_surat_tugas DateTime? @db.Date
  ptk_induk           Decimal?  @db.Decimal
  tmt_tugas           DateTime? @db.Date
  tgl_ptk_keluar      DateTime? @db.Date

  // --- Kolom SIMAK (dipertahankan) ---
  qr_token    String?
  foto        String?
  status      String  @default("Aktif")
  no_whatsapp String?
  id_telegram String?
  nama_kcp    String?

  // --- Relations ---
  jenis_ptk                 jenis_ptk?                @relation(fields: [jenis_ptk_id], references: [jenis_ptk_id], onDelete: NoAction, onUpdate: NoAction)
  status_kepegawaian        status_kepegawaian?       @relation(fields: [status_kepegawaian_id], references: [status_kepegawaian_id], onDelete: NoAction, onUpdate: NoAction)
  jabatan_ptk               jabatan_ptk?              @relation(fields: [jabatan_ptk_id], references: [jabatan_ptk_id], onDelete: NoAction, onUpdate: NoAction)
  sumber_gaji               sumber_gaji?              @relation(fields: [sumber_gaji_id], references: [sumber_gaji_id], onDelete: NoAction, onUpdate: NoAction)
  agama                     agama?                    @relation(fields: [agama_id], references: [agama_id], onDelete: NoAction, onUpdate: NoAction)
  pembelajaran              Pembelajaran[]
  tugas_tambahan            TugasTambahan[]
  penggunas                 Pengguna[]
  riwayat_pendidikan_formal RiwayatPendidikanFormal[]
  rwy_sertifikasi           RwySertifikasi[]
  rwy_kepangkatan           RwyKepangkatan[]
  izins                     Izin[]
  pelanggaran_dilaporkan    Pelanggaran[]             @relation("PelaporGtk")
  pelanggaran               Pelanggaran[]             @relation("GtkPelanggaran")
  presensiGtks              PresensiGtk[]
  surat_keluar              SuratKeluar[]
  tindak_lanjut_petugas     TindakLanjut[]            @relation("PetugasTindakLanjut")
  bimbing_pd                BimbingPd[]

  @@index([sekolah_id])
  @@index([qr_token])
  @@map("gtks")
  @@schema("dapodik")
}

model Pengguna {
  pengguna_id      String        @id @default(uuid()) @db.Uuid
  sekolah_id       String?       @db.Uuid
  username         String        @unique
  password         String
  nama             String
  email            String?       @unique
  peran_nama       String?
  peran_id         Int?
  alamat           String?
  no_telepon       String?
  no_hp            String?
  ptk_id           String?       @db.Uuid
  peserta_didik_id String?       @db.Uuid
  google2fa_secret String?
  remember_token   String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  peserta_didik    PesertaDidik? @relation(fields: [peserta_didik_id], references: [peserta_didik_id], onDelete: Cascade)
  gtk              Gtk?          @relation(fields: [ptk_id], references: [ptk_id], onDelete: Cascade)

  @@map("pengguna")
  @@schema("dapodik")
}

